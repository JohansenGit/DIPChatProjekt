html
    head
        title Brugeradministration
        link(rel="stylesheet" href="/css/userAdmin.css")
        script(src="/methods/userAdmin.js" defer)
        script(src="/methods/methods.js" defer)

    body
        .adminContainer
            header
                .headerText
                    h1 Brugeradministration
                    p.adminSubtitle Administrer brugere og se deres status

                a.backBtn(href="/chats") Tilbage til chats

            main
                .tableContainer
                    table
                        thead
                            tr
                                th Brugernavn
                                th Niveau
                                th Oprettet dato
                                th Online
                                th Handling

                        tbody
                            each user in users
                                tr
                                    td.usernameCell= user.username
                                    td
                                        span.levelBadge= user.level
                                    td= user.creationDate
                                    td
                                        if user.isOnline
                                            span.statusLabel.online
                                                span.status-circle.online
                                                | Online
                                        else
                                            span.statusLabel.offline
                                                span.status-circle.offline
                                                | Offline
                                    td
                                        button(type="button" class="deleteBtn" data-id=user.id data-type="users") Slet
