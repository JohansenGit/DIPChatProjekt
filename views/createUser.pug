html
    head
        title Opret Ny Bruger
        script(src="/methods.js" defer)

    body
        label Opret Ny Bruger
        form(action="/users/createUser", method="POST")
            label Brugernavn: 
                input(type="text", name="username", placeholder="username")
            label Kodeord: 
                input(type="text", name="password", placeholder="password")
            
            label Bruger Niveau      
                select(name="level")
                    option(value="1") Level 1 - Læs chat
                    option(value="2") Level 2 - Skriv og ændre 
                    option(value="3") Level 3 - Admin
        
            button(type="submit") Opret Bruger