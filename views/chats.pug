html
    head
        title Chat oversigt
        script(src="/methods/methods.js" defer)
        link(rel="stylesheet" href="/css/chats.css")

    body
        .pageContainer
            header
                h1 Mine chats
                p.chatSubtitle Vælg en samtale eller opret en ny

            nav
                button.createBtn(type="button" onclick="window.location.href='/chats/createChat'") + Opret chat

                button(type="button" onclick="window.location.href='/chats/messages'") Se dine beskeder

                button(type="button" onclick="window.location.href='/users/administration'") Administrer brugere

                form(action="/logout" method="POST")
                    button.logoutBtn(type="submit") Log ud

            main
                h2 Dine samtaler

                ul
                    each chat in chats
                        li
                            a.chatLink(href=`/chats/${chat.id}`)= chat.chatName
                            button.deleteBtn(type="button" data-id=chat.id data-type="chats") Slet chat
