html
    head
        title Chat oversigt
        script(src="/methods/methods.js" defer)

    body
        button(type="button" onclick="window.location.href='/chats/createChat'") Opret chat

        button(type="button" onclick="window.location.href='/chats/messages'") Se dine beskeder

        button(type="button" onclick="window.location.href='/users/administration'") Administrer brugere

        form(action="/logout" method="POST")
            button(type="submit") Log ud

        ul
            each chat in chats
                li
                    a(href=`/chats/${chat.id}`)= chat.chatName
                    button.deleteBtn(data-id=chat.id data-type="chats") Slet chat
                    