html
    head
        title Dine beskeder
    body
        h1 Dine beskeder
        link(rel="stylesheet" href="/css/createUser.css")
        
        if messages.length > 0
            ul
                each message in messages
                    li
                        strong= message.chatName
                        p= message.message
                        small= message.creationDate
        else
            p Du har ikke sendt nogen beskeder endnu.