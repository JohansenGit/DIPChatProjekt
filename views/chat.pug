html
    head
        title= chat.chatName
        button(type="button" onclick="window.location.href='/chats/'") Tilbage
    body
        ul
            each message in chat.messageArray
                li= message.message

        form(action="/chats/" + chat.id method="POST")
            input(type="text" name="message" placeholder="Message...") 
            button(type="submit") Send