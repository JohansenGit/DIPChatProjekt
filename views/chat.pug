html
    head
        title= chat.chatName
        button(type="button" onclick="window.location.href='/chats/'") Tilbage
    body
        ul
            each message in chat.messageArray
                li= message.message

        form#messageForm(action="/chats/" + chat.id + "/messages" method="POST")
            input#messageInput(type="text" name="message" placeholder="Message...")
            button(type="submit") Send

        p#errorMessage(style="color: red")

        script(src="/methods/message.js" defer)