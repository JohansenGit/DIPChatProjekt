html
    head
        title= chat.chatName
        h1= chat.chatName
        button(type="button" onclick="window.location.href='/chats/'") Tilbage
        button#renameBtn(type="button" data-id=chat.id data-name = chat.name) omdøb
    body
        ul
            each message in chat.messageArray
                li= message.message

        form(action="/chats/" + chat.id + "/messages" method="POST")
            input(type="text" name="message" placeholder="Message...") 
            button(type="submit") Send